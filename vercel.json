{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "src",
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/anime", "destination": "/pages/anime.html" },
    { "source": "/watch", "destination": "/pages/watch.html" },
    { "source": "/busca", "destination": "/pages/busca.html" },
    { "source": "/catalogo", "destination": "/pages/catalogo.html" },
    { "source": "/genero", "destination": "/pages/genero.html" },
    { "source": "/sobre", "destination": "/pages/sobre.html" },
    { "source": "/contato", "destination": "/pages/contato.html" },
    { "source": "/dmca", "destination": "/pages/dmca.html" },
    { "source": "/404", "destination": "/pages/404.html" }
  ]
}
