{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "src",
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/pages" },
    { "source": "/anime", "destination": "/pages/anime" },
    { "source": "/watch", "destination": "/pages/watch" },
    { "source": "/busca", "destination": "/pages/busca" },
    { "source": "/catalogo", "destination": "/pages/catalogo" },
    { "source": "/genero", "destination": "/pages/genero" },
    { "source": "/sobre", "destination": "/pages/sobre" },
    { "source": "/contato", "destination": "/pages/contato" },
    { "source": "/dmca", "destination": "/pages/dmca" },
    { "source": "/entrar", "destination": "/pages/entrar" },
    { "source": "/registar", "destination": "/pages/registar" },
    { "source": "/favoritos", "destination": "/pages/favoritos" },
    { "source": "/perfil", "destination": "/pages/perfil" },
    { "source": "/historico", "destination": "/pages/historico" },
    { "source": "/404", "destination": "/pages/404" }
  ]
}
